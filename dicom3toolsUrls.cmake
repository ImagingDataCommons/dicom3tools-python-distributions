# URLs and checksums for the dicom3tools binary archives that this project wraps.
#
# This file is the seam between the two halves of the project: the build workflows in
# ImagingDataCommons/dicom3tools compile per-platform archives and attach them to a GitHub
# release, and this file pins exactly which ones a wheel is built from. The wheel layer never
# knows or cares who produced them -- so if the archives ever move (upstream dclunie.com, a
# different repository), only the variables below change and nothing else in the repo moves.
#
# Regenerate the auto-generated section with:
#
#   python scripts/update_dicom3tools_urls.py --tag <tag>
#
# One cache variable allows repointing a build without editing this file:
#
#   -DDICOM3TOOLS_BINARIES_BASE_URL=file:///path/to/dir   # archives from a local dir
#
# Note that the checksums are always enforced. To build against a different set of archives,
# run the update script rather than overriding the hash check.

# These two are rewritten by the update script along with the checksums below, and must stay
# consistent with them: they are what turns a pinned filename into a URL. The tag is an
# immutable release, never a rolling pointer such as "latest".
#
# The tag matters more here than it does in the projects this one is modelled on. The
# dicom3tools assets are named identically in every release -- there is no version or commit in
# the filename -- so a stale tag does not 404, it downloads a real archive from the wrong
# release and fails the checksum. The tag is the version.
set(DICOM3TOOLS_BINARIES_REPO "ImagingDataCommons/dicom3tools"
  CACHE STRING "GitHub repository hosting the dicom3tools binary archives")
set(DICOM3TOOLS_BINARIES_TAG "dicom3tools.20260927113651.post1"
  CACHE STRING "Release tag hosting the dicom3tools binary archives")
set(DICOM3TOOLS_BINARIES_BASE_URL ""
  CACHE STRING "Override the base URL the archives are fetched from (default: the GitHub release)")

# The section below is auto-generated by scripts/update_dicom3tools_urls.py
# Do not edit this section directly.

set(dicom3tools_snapshot "20260927113651")
set(dicom3tools_version  "20260927")

set(linux_x86_64_filename   "dicom3tools-linux-x86_64.tar.gz")
set(linux_x86_64_sha256     "4351f070172402be6ad6b95909ad5e2ca9a520540e8957ba8fda6e7552b26635")

set(linux_aarch64_filename  "dicom3tools-linux-aarch64.tar.gz")
set(linux_aarch64_sha256    "489704a37f4de005bacbf022f859c40f3dc732421e557468fc727975ce72b6f2")

set(macos_arm64_filename    "dicom3tools-macos-arm64.tar.gz")
set(macos_arm64_sha256      "6c0821f9c7e3d6d0067ff067ed50b4c0b49d0be6326c3a83d143142e6a1a3265")

set(macos_x86_64_filename   "dicom3tools-macos-x86_64.tar.gz")
set(macos_x86_64_sha256     "65da2cf9f392c9d3ab776f49c8adee267b768a7e899031e2e7e89752bbfe29f5")

set(win64_filename          "dicom3tools-windows-x86_64.zip")
set(win64_sha256            "6b4f8c85fff0f60e67a08f8194507266870142964917d13a8dcd5b16fd8d3d9c")

# The section above is auto-generated by scripts/update_dicom3tools_urls.py
# Do not edit this section directly.

#
# Pick the archive for the machine the wheel is being built for.
#
# There is no cross-compilation anywhere in this project: the archives are prebuilt
# single-architecture binaries that cannot be retargeted at wheel-build time, so each wheel is
# built on a runner of its own architecture (see .github/workflows/cd.yml) and the choice is
# made from the host processor.
#
if(APPLE)
  if(CMAKE_SYSTEM_PROCESSOR STREQUAL "arm64")
    set(archive "macos_arm64")
  else()
    set(archive "macos_x86_64")
  endif()
elseif(WIN32)
  # The Windows package is built under Cygwin as 64-bit x86 only. An ARM64 Windows machine can
  # run it through emulation, but the wheel would then be tagged win_arm64 and claim otherwise.
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|x86_64)$")
    set(archive "win64")
  else()
    message(FATAL_ERROR
      "No dicom3tools archive is published for this Windows architecture "
      "(CMAKE_SYSTEM_PROCESSOR=${CMAKE_SYSTEM_PROCESSOR}). Only 64-bit x86 is supported.")
  endif()
else()
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    set(archive "linux_x86_64")
  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
    set(archive "linux_aarch64")
  else()
    message(FATAL_ERROR
      "No dicom3tools archive is published for this Linux architecture "
      "(CMAKE_SYSTEM_PROCESSOR=${CMAKE_SYSTEM_PROCESSOR}). Only x86_64 and aarch64 are built.")
  endif()
endif()

if(NOT DEFINED "${archive}_filename")
  message(FATAL_ERROR "Failed to determine which archive to download: '${archive}_filename' is not defined")
endif()

if(NOT DEFINED "${archive}_sha256")
  message(FATAL_ERROR "Could you make sure variable '${archive}_sha256' is defined ?")
endif()

set(dicom3tools_archive_filename "${${archive}_filename}")
set(dicom3tools_archive_sha256 "${${archive}_sha256}")

if(DICOM3TOOLS_BINARIES_BASE_URL)
  set(_base_url "${DICOM3TOOLS_BINARIES_BASE_URL}")
else()
  set(_base_url
    "https://github.com/${DICOM3TOOLS_BINARIES_REPO}/releases/download/${DICOM3TOOLS_BINARIES_TAG}")
endif()

set(dicom3tools_archive_url "${_base_url}/${dicom3tools_archive_filename}")
